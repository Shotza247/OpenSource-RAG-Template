APP_ENV=local
# Optional exact answer cache; requires uv sync --extra cache and Docker Redis.
ANSWER_CACHE_MODE=off
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_TIMEOUT=1.0
ANSWER_CACHE_TTL=3600
ANSWER_CACHE_NAMESPACE=faq-answer-v1
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_EVIDENCE_OVERLAP=0.67
SEMANTIC_CACHE_MAX_CANDIDATES=100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
VECTOR_STORE=qdrant
# Optional local catalog override; blank keeps .local/library.sqlite3.
CATALOG_PATH=

QDRANT_PORT=6333
CHROMA_PORT=8001
VECTOR_URL=http://localhost:6333
VECTOR_API_KEY=
COLLECTION=faq_documents
CORPUS_VERSION=v1
HF_TOKEN=

EMBEDDING_URL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

EMBEDDING_REVISION=main
VECTOR_DIMENSIONS=384
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_DOCUMENT_PREFIX=
LLM_BASE_URL=https://router.huggingface.co/v1

LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale
LLM_PROVIDER=huggingface
REQUEST_TIMEOUT=30
CONTEXT_K=4
CHUNK_CHARS=1000
CHUNK_OVERLAP=150
