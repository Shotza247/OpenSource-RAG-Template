# Create local settings with scripts/setup_env.py --sync. Never commit .env.
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
VECTOR_STORE=qdrant
# Host ports may differ between local projects; VECTOR_URL must match QDRANT_PORT.
QDRANT_PORT=6333
CHROMA_PORT=8001
VECTOR_URL=http://localhost:6333
VECTOR_API_KEY=
COLLECTION=master_career_portfolio
CORPUS_VERSION=v1
HF_TOKEN=
# Full hosted TEI URL including /embed; one vector per input.
EMBEDDING_URL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pin the same immutable revision here and on the endpoint before release.
EMBEDDING_REVISION=main
VECTOR_DIMENSIONS=484
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_DOCUMENT_PREFIX=
# Optional second TEI endpoint hosting a cross-encoder, including /rerank.
RERANK_URL=
RERANK_MIN_SCORE=0.0
LLM_BASE_URL=https://router.huggingface.co/v1
# Select an available open-weight model/provider with tool calling.
LLM_MODEL=
REQUEST_TIMEOUT=30
CANDIDATE_K=12
CONTEXT_K=4
CHUNK_CHARS=1000
CHUNK_OVERLAP=150
MAX_TOOL_CALLS=2
